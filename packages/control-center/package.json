{
  "name": "@dsh-control-center/control-center",
  "version": "0.3.0",
  "description": "Cherry-style settings, provider, and model control surface for DSH Web",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./translation-types": {
      "types": "./lib/types/translation-types.d.ts",
      "default": "./lib/types/translation-types.js"
    },
    "./translation-remote": {
      "types": "./lib/types/translation-remote-client.d.ts",
      "default": "./lib/translation-remote-client.js"
    },
    "./painting-types": {
      "types": "./lib/types/painting-types.d.ts",
      "default": "./lib/types/painting-types.js"
    },
    "./painting-remote": {
      "types": "./lib/types/painting-remote-client.d.ts",
      "default": "./lib/painting-remote-client.js"
    },
    "./knowledge-types": {
      "types": "./lib/types/knowledge-types.d.ts",
      "default": "./lib/types/knowledge-types.js"
    },
    "./knowledge-remote": {
      "types": "./lib/types/knowledge-remote-client.d.ts",
      "default": "./lib/knowledge-remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.js"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-api-remotes/client",
        "@deepseek-ai/dsh-client-connection/client",
        "@deepseek-ai/dsh-client-locale/client",
        "@deepseek-ai/dsh-client-ui-layout/client",
        "@deepseek-ai/dsh-client-ui-session/client",
        "@deepseek-ai/dsh-client-ui-settings/client",
        "@deepseek-ai/dsh-client-ui-sidebar/client"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-attachment": "0.1.2",
    "@deepseek-ai/dsh-credentials": "0.1.2",
    "@deepseek-ai/dsh-fs": "0.1.2",
    "@deepseek-ai/dsh-home-paths": "0.1.2",
    "@deepseek-ai/dsh-llm": "0.1.2",
    "@deepseek-ai/dsh-settings": "0.1.2",
    "@deepseek-ai/dsh-storage": "0.1.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.2",
    "@deepseek-ai/dsh-subprocess": "0.1.2",
    "@deepseek-ai/dsh-tools": "0.1.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2",
    "@deepseek-ai/dsh-typert-registry": "0.1.2",
    "@deepseek-ai/schemastery": "0.1.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@paddleocr/api-sdk": "0.2.0",
    "@tiptap/core": "^3.30.3",
    "@tiptap/extension-blockquote": "^3.30.3",
    "@tiptap/extension-bold": "^3.30.3",
    "@tiptap/extension-bullet-list": "^3.30.3",
    "@tiptap/extension-code": "^3.30.3",
    "@tiptap/extension-code-block": "^3.30.3",
    "@tiptap/extension-gapcursor": "^3.30.3",
    "@tiptap/extension-heading": "^3.30.3",
    "@tiptap/extension-history": "^3.30.3",
    "@tiptap/extension-image": "^3.30.3",
    "@tiptap/extension-italic": "^3.30.3",
    "@tiptap/extension-link": "^3.30.3",
    "@tiptap/extension-ordered-list": "^3.30.3",
    "@tiptap/extension-placeholder": "^3.30.3",
    "@tiptap/extension-strike": "^3.30.3",
    "@tiptap/extension-table": "^3.30.3",
    "@tiptap/extension-table-cell": "^3.30.3",
    "@tiptap/extension-table-header": "^3.30.3",
    "@tiptap/extension-table-row": "^3.30.3",
    "@tiptap/extension-task-item": "^3.30.3",
    "@tiptap/extension-task-list": "^3.30.3",
    "@tiptap/extension-text-align": "^3.30.3",
    "@tiptap/extension-text-style": "^3.30.3",
    "@tiptap/extension-typography": "^3.30.3",
    "@tiptap/extension-underline": "^3.30.3",
    "@tiptap/pm": "^3.30.3",
    "@tiptap/react": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "clsx": "^2.1.1",
    "fflate": "0.8.3",
    "flexsearch": "^0.8.212",
    "pdfjs-dist": "^6.2.108",
    "qrcode-generator": "^2.0.4",
    "react-dom": "^18.2.0",
    "tiptap-markdown": "^0.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-credentials-local": "0.1.2",
    "@deepseek-ai/dsh-settings-file": "0.1.2",
    "@types/react-dom": "~18.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.2 <0.2.0-0",
    "@deepseek-ai/dsh-attachment": ">=0.1.2 <0.2.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.2 <0.2.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.2 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.2 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.2 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2 <0.2.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.1.2 <0.2.0-0",
    "@deepseek-ai/dsh-invariants": ">=0.1.2 <0.2.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.2 <0.2.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.2 <0.2.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.2 <0.2.0-0",
    "@deepseek-ai/dsh-typert-registry": ">=0.1.2 <0.2.0-0",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-store": ">=0.1.2 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.2 <0.2.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bundle": "tsdown"
  }
}
