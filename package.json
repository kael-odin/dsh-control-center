{
  "name": "dsh-control-center",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -b && pnpm -r --if-present run bundle",
    "clean": "node -e \"require('node:fs').rmSync('packages/bundle/lib',{recursive:true,force:true});require('node:fs').rmSync('packages/control-center/lib',{recursive:true,force:true});require('node:fs').rmSync('.pack-bundle',{recursive:true,force:true})\"",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:browser": "pnpm run pack:check && tsx tests/context-policy-profile-e2e.ts && tsx tests/packed-browser-e2e.ts",
    "lint": "oxlint packages/bundle/src packages/control-center/src build tests --deny-warnings",
    "verify:provenance": "tsx tests/provenance.ts",
    "verify:artifacts": "tsx tests/artifacts.ts",
    "verify:secrets": "tsx tests/secrets.ts",
    "pack:check": "pnpm run build && pnpm run verify:provenance && pnpm run verify:artifacts && pnpm --filter @dsh-control-center/control-center pack --pack-destination .packs && tsx tests/prepare-bundle-pack.ts && pnpm --dir .pack-bundle pack --pack-destination ../.packs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run build && pnpm run verify:provenance && pnpm run verify:artifacts && pnpm run verify:secrets && node scripts/check-parity.mjs",
    "watch:contract": "node scripts/watch-dsh-contract.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-settings-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-modules": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/use-sync-external-store": "^1.5.0",
    "immer": "^10.1.1",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "oxlint": "1.76.0",
    "playwright": "1.61.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "use-sync-external-store": "^1.2.0",
    "vitest": "^4.1.8",
    "zustand": "~4.4.7"
  }
}
