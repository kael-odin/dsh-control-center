{
  "appId": "com.dshcontrolcontrolcenter.desktop",
  "productName": "DSH Control Center",
  "executableName": "dsh-control-center",
  "copyright": "Copyright © 2026 kael-odin",
  "directories": {
    "output": "release"
  },
  "files": [
    "bin/**",
    "build/**",
    "package.json"
  ],
  "extraResources": [
    { "from": "vendor/node", "to": "vendor/node", "filter": ["**/*"] },
    { "from": "vendor/bundle.tgz", "to": "vendor/bundle.tgz" },
    { "from": "vendor/bundle-version.json", "to": "vendor/bundle-version.json" }
  ],
  "asar": true,
  "npmRebuild": false,
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
  },
  "mac": {
    "target": [{ "target": "dmg" }],
    "category": "public.app-category.productivity",
    "identity": null,
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "maintainer": "kael-odin",
    "category": "Utility",
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
