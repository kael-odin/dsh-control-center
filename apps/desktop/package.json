{
  "name": "@dsh-control-center/desktop",
  "version": "0.3.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "DSH Control Center desktop shell — Electron runner that loads the DSH loopback Web surface and mounts the Control Center plugin surface.",
  "homepage": "https://github.com/kael-odin/dsh-control-center",
  "author": { "name": "kael-odin" },
  "main": "bin/main.mjs",
  "bin": {
    "dsh-control-desktop": "bin/main.mjs"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "node tests/smoke.mjs",
    "smoke:selfhost": "node tests/smoke.mjs --selfhost",
    "smoke:packed": "node tests/packed-smoke.mjs",
    "probe:hostinmain": "node tests/host-in-main-probe.mjs",
    "probe:materialize": "node tests/materialize-smoke.mjs",
    "probe:v6synth": "node tests/v6-synth.mjs",
    "probe:selfcontained": "node tests/selfcontained-smoke.mjs",
    "pack:dir": "electron-builder --dir",
    "pack:win": "electron-builder --win nsis",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:linux": "electron-builder --linux AppImage deb --x64",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "electron": "41.8.0",
    "electron-builder": "^26.15.3"
  }
}
